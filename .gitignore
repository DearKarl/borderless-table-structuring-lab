# Dataset payloads are stored in a separate private dataset repository.
data/
datasets/
dataset/shards/
dataset/cache/
*.parquet
*.arrow
*.tar
*.tar.gz
*.webdataset

# Model and experiment payloads are never committed here.
artifacts/*
!artifacts/*.json
checkpoints/
models/
outputs/
predictions/
results/
runs/
# Public aggregate-only result archive; page payloads stay excluded.
!artifacts/results/
artifacts/results/**
!artifacts/results/**/
!artifacts/results/README.md
!artifacts/results/v3-reported-20261007.json
