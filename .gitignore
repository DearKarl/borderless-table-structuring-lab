*.ckpt
*.onnx
*.pt
*.pth
*.safetensors
*.safe-state
*.part[0-9][0-9][0-9]
*.partial

# Credentials and local access configuration.
*.pem
*.key
credentials.json
token.json

# Legacy internal coordination records are not public repository content.
governance/
evidence/
Handoff.md

# Local research workflow and role onboarding are never public repository content.
/codex/
/AGENTS.md

